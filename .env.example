# Shared local configuration for the app and REST API.
# Copy to .env in the repository root. Existing shell variables take precedence.

# Public frontend configuration (included in builds; never put secrets here).
# Used by desktop and iOS account sign-in and study-data synchronization.
PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# REST API configuration. Keep private values free of PUBLIC_ and VITE_ prefixes.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Relative to restapi/ when using the API npm scripts.
DATABASE_PATH=./data/obstudy-api.db
REGISTRATION_ENABLED=true
SESSION_DAYS=30
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost
