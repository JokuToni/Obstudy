# Shared local configuration. Copy to .env; never commit the real file.
PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Public gateway (service/).
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_SERVICE_URL=http://127.0.0.1:4000
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Shared only between the gateway and database service. Never expose to clients.
DATABASE_SERVICE_TOKEN=replace-with-a-random-secret-at-least-32-characters
DATABASE_SERVICE_TIMEOUT_MS=25000
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost

# Private SQLite service (database-service/). Relative database path resolves there.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=4000
DATABASE_PATH=./data/obstudy-api.db
REGISTRATION_ENABLED=true
SESSION_DAYS=30
# Exact PUBLIC gateway origin for browser CSRF/cookie checks, not the internal URL.
WEB_ORIGIN=http://127.0.0.1:3000
