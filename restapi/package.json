{
    "name": "@obstudy/restapi",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "REST API for Obstudy device synchronization.",
    "engines": {
        "node": ">=24.10.0 <25"
    },
    "scripts": {
        "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
        "check": "tsc --noEmit && tsc -p tsconfig.test.json",
        "build": "tsc",
        "start": "node --env-file-if-exists=.env dist/server.js",
        "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
        "test": "node --import tsx --test tests/*.test.ts"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@fastify/cors": "^11.4.3",
        "@fastify/helmet": "^13.2.0",
        "@fastify/rate-limit": "^11.3.0",
        "fastify": "^5.12.8",
        "ts-fsrs": "5.4.2",
        "zod": "^4.6.7"
    }
}
