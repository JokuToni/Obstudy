{
    "name": "@obstudy/restapi",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "REST API for Obstudy device synchronization.",
    "engines": {
        "node": ">=24.10.0 <25"
    },
    "scripts": {
        "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
        "check": "tsc --noEmit",
        "build": "tsc",
        "start": "node --env-file-if-exists=.env dist/server.js"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "fastify": "^5.12.8"
    }
}
