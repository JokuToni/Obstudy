# Optional service-local overrides. Shared defaults live in ../.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=./data/obstudy-api.db
# Enable to create your account; disable again for a private deployment.
REGISTRATION_ENABLED=true
SESSION_DAYS=30
# Exact origins only. Native HTTP clients do not require CORS.
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost
