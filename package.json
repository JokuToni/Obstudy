{
    "name": "obstudy",
    "version": "0.1.0",
    "description": "An Obsidian-based desktop study application.",
    "type": "module",
    "scripts": {
        "dev": "node scripts/syncExcalidrawAssets.mjs && vite dev",
        "build": "node scripts/syncExcalidrawAssets.mjs && vite build",
        "preview": "vite preview",
        "prepare": "node scripts/syncExcalidrawAssets.mjs && svelte-kit sync",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "tauri": "tauri",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:ui": "playwright test",
        "test:unit": "playwright test --config playwright.unit.config.ts",
        "dev:ios": "vite dev --mode ios",
        "build:ios": "vite build --mode ios",
        "ios:init": "tauri ios init",
        "ios:dev": "tauri ios dev",
        "ios:build": "tauri ios build",
        "dev:web": "node scripts/runWeb.mjs dev",
        "build:web": "node scripts/runWeb.mjs build",
        "test:web": "playwright test --config playwright.web.config.ts"
    },
    "license": "MIT",
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@excalidraw/excalidraw": "^0.18.1",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-dialog": "^2",
        "@tauri-apps/plugin-fs": "^2",
        "@tauri-apps/plugin-opener": "^2",
        "@tauri-apps/plugin-sql": "^2",
        "@tauri-apps/plugin-store": "^2.5.0",
        "codemirror": "^6.0.2",
        "jquery": "^3.7.1",
        "katex": "^0.19.0",
        "mathquill": "^0.10.1-a",
        "openai": "^7.43.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "ts-fsrs": "^5.4.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.65.1",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2",
        "@types/katex": "^0.16.8",
        "@types/node": "^26.6.5",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.56.3",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vite": "^8.0.16"
    },
    "private": true,
    "overrides": {
        "mathquill": {
            "jquery": "$jquery"
        },
        "lodash-es": "^4.18.1",
        "@excalidraw/excalidraw": {
            "nanoid": "^3.3.20",
            "@excalidraw/mermaid-to-excalidraw": {
                "nanoid": "^5.1.16"
            }
        }
    }
}
